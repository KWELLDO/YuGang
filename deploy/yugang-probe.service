[Unit]
Description=YuGang end-to-end probe (gateway, memory, disk, budget)
After=yugang.service

[Service]
Type=oneshot
User=dafeiyu
Group=dafeiyu
WorkingDirectory=/home/dafeiyu/yugang
ExecStart=/usr/local/sbin/yugang-probe.sh
Nice=10
MemoryMax=300M
CPUQuota=30%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/dafeiyu
