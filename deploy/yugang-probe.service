[Unit]
Description=YuGang end-to-end probe (gateway, memory, disk, budget)
After=yugang.service

[Service]
Type=oneshot
User=dafeiyu
Group=dafeiyu
WorkingDirectory=/home/dafeiyu/yugang
# Same credentials as the gateway: the deep probe makes one real model call a day,
# and a probe that cannot authenticate reports a healthy process forever.
EnvironmentFile=/etc/dafeiyu-dsh.env
Environment=PYTHONPATH=/home/dafeiyu/yugang/src
ExecStart=/usr/local/sbin/yugang-probe.sh
Nice=10
MemoryMax=300M
CPUQuota=30%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/dafeiyu
