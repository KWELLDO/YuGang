# Install as /etc/dafeiyu-dsh.env, root:root 0600. Never commit the real file.
DEEPSEEK_API_KEY=sk-replace-me
YUGANG_HTTP_TOKEN=replace-with-a-long-random-token
# Optional mail channel; leave disabled in config until a mailbox is provisioned.
# YUGANG_EMAIL_PASSWORD=replace-me
# Optional OneBot/QQ bridge; leave disabled in config until NapCat is provisioned.
# YUGANG_ONEBOT_WEBHOOK_SECRET=replace-me
# YUGANG_ONEBOT_TOKEN=replace-me